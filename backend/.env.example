NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://kb_user:kb_pass@localhost:5432/enterprise_kb

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents

QDRANT_URL=http://localhost:6333
QDRANT_VECTOR_SIZE=768

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Worker — parallel document slots (raise on GPU hosts, lower on RAM-constrained machines)
WORKER_CONCURRENCY=4

# Chat history — turns older than this many days are pruned from Qdrant automatically
CHAT_HISTORY_MAX_AGE_DAYS=90
