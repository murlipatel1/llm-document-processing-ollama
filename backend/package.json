{
  "name": "@enterprise-kb/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:all": "concurrently --kill-others-on-fail -n api,worker -c cyan,yellow \"npm run dev\" \"npm run worker\"",
    "start": "node src/server.js",
    "worker": "node src/modules/processor/worker.js",
    "docker:up": "docker compose up -d",
    "docker:infra": "docker compose up -d redis minio qdrant",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f redis",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.56.8",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.6.1",
    "mammoth": "^1.9.0",
    "minio": "^8.0.6",
    "pdf-parse": "^1.1.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prisma": "^6.8.2"
  }
}
